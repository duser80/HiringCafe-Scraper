# ---------------------------------------------------------------------------
# HiringCafe Jobs API service configuration
# Copy to .env and fill in the secrets. Never commit .env.
# ---------------------------------------------------------------------------

# Environment: production | development
ENV=production
LOG_LEVEL=INFO

# --- Secrets (required) -----------------------------------------------------
# Postgres password used by the compose stack.
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-strong-password

# Admin bearer token for /v1/admin/* endpoints (min 16 chars).
# Generate: openssl rand -hex 32
ADMIN_TOKEN=change-me-admin-token-min-16-chars

# --- API --------------------------------------------------------------------
# Host port the API is published on.
API_PORT=8000
# Default per-key rate limit for newly created keys (requests/minute).
DEFAULT_RATE_LIMIT_PER_MINUTE=120

# --- Worker / ingestion -----------------------------------------------------
# Minutes between ingest cycles.
SCRAPE_INTERVAL_MINUTES=180
# Max pages per slice per cycle (each page ~100-160 jobs).
SCRAPE_MAX_PAGES_PER_SLICE=60
# Politeness delay between upstream requests (seconds).
SCRAPE_DELAY_SECONDS=1.0
# Jobs unseen for this many days are marked inactive (soft delete).
DEACTIVATE_AFTER_DAYS=14

# Custom search slices (JSON array). Empty = one broad newest-first slice.
# Example:
# SLICES_JSON=[{"name":"us-eng","search_state":{"searchQuery":"engineer","sortBy":"date"},"max_pages":40}]
SLICES_JSON=

# Residential proxy for cloud deployments (DataImpulse sticky session URL).
# Format: http://USER:PASS@gw.dataimpulse.com:823
# Leave empty when running from a residential IP.
PROXY_URL=

# --- Local development outside Docker ---------------------------------------
# DATABASE_URL=postgresql+asyncpg://hiringcafe:PASSWORD@localhost:5432/hiringcafe
# REDIS_URL=redis://localhost:6379/0
